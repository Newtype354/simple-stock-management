  <bpmn:process id="Laporan" name="Melihat dan mengekspor data stok" isExecutable="false">
    <bpmn:documentation>Proses ini dapat dimulai oleh pengguna toko atau manajer. Keduanya harus login; ekspor mensyaratkan grup shop_users atau managers. Data mengikuti cakupan hak akses pengguna.</bpmn:documentation>
    <bpmn:laneSet id="Laporan_lanes">
      <bpmn:lane id="Laporan_lane0" name="Pengguna toko">
        <bpmn:flowNodeRef>Laporan_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Laporan_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Laporan_export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Laporan_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Laporan_lane1" name="Manajer gudang" />
      <bpmn:lane id="Laporan_lane2" name="Sistem aplikasi">
        <bpmn:flowNodeRef>Laporan_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Laporan_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Laporan_file</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Laporan_start" name="Perlu informasi stok">
      <bpmn:outgoing>Laporan_flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Laporan_request" name="Pilih data, pencarian, dan pengurutan">
      <bpmn:incoming>Laporan_flow0</bpmn:incoming>
      <bpmn:outgoing>Laporan_flow1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Laporan_read" name="Periksa akses dan baca data sesuai cakupan pengguna">
      <bpmn:incoming>Laporan_flow1</bpmn:incoming>
      <bpmn:outgoing>Laporan_flow2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Laporan_show" name="Tampilkan stok dengan pagination">
      <bpmn:incoming>Laporan_flow2</bpmn:incoming>
      <bpmn:outgoing>Laporan_flow3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Laporan_export" name="Unduh Excel?">
      <bpmn:incoming>Laporan_flow3</bpmn:incoming>
      <bpmn:outgoing>Laporan_flow4</bpmn:outgoing>
      <bpmn:outgoing>Laporan_flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Laporan_file" name="Buat spreadsheet dan kirim unduhan">
      <bpmn:incoming>Laporan_flow4</bpmn:incoming>
      <bpmn:outgoing>Laporan_flow6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Laporan_end" name="Informasi stok tersedia">
      <bpmn:incoming>Laporan_flow5</bpmn:incoming>
      <bpmn:incoming>Laporan_flow6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Laporan_flow0" sourceRef="Laporan_start" targetRef="Laporan_request" />
    <bpmn:sequenceFlow id="Laporan_flow1" sourceRef="Laporan_request" targetRef="Laporan_read" />
    <bpmn:sequenceFlow id="Laporan_flow2" sourceRef="Laporan_read" targetRef="Laporan_show" />
    <bpmn:sequenceFlow id="Laporan_flow3" sourceRef="Laporan_show" targetRef="Laporan_export" />
    <bpmn:sequenceFlow id="Laporan_flow4" sourceRef="Laporan_export" targetRef="Laporan_file" name="Ya" />
    <bpmn:sequenceFlow id="Laporan_flow5" sourceRef="Laporan_export" targetRef="Laporan_end" name="Tidak" />
    <bpmn:sequenceFlow id="Laporan_flow6" sourceRef="Laporan_file" targetRef="Laporan_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Laporan_diagram" name="Melihat dan mengekspor data stok">
    <bpmndi:BPMNPlane id="Laporan_plane" bpmnElement="Laporan">
      <bpmndi:BPMNShape id="Laporan_laneShape0" bpmnElement="Laporan_lane0" isHorizontal="true">
