  <bpmn:process id="Kelola" name="Pengelolaan stok dan impor Excel" isExecutable="false">
    <bpmn:documentation>Prasyarat: login sebagai anggota managers. Impor mensyaratkan allow_uploads aktif. Penghapusan data yang tidak ada di spreadsheet mengikuti allow_upload_deletions. Manajer dapat mengaktifkan maintenance untuk membatasi transfer toko selama pemeliharaan stok. Akun, grup, dan konfigurasi dikelola melalui Django Admin sesuai izin.</bpmn:documentation>
    <bpmn:laneSet id="Kelola_lanes">
      <bpmn:lane id="Kelola_lane0" name="Pengguna toko" />
      <bpmn:lane id="Kelola_lane1" name="Manajer gudang">
        <bpmn:flowNodeRef>Kelola_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kelola_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kelola_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kelola_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kelola_upload</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Kelola_lane2" name="Sistem aplikasi">
        <bpmn:flowNodeRef>Kelola_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kelola_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kelola_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Kelola_persist</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Kelola_start" name="Perlu memperbarui stok">
      <bpmn:outgoing>Kelola_flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Kelola_choose" name="Cara pembaruan?">
      <bpmn:incoming>Kelola_flow0</bpmn:incoming>
      <bpmn:outgoing>Kelola_flow1</bpmn:outgoing>
      <bpmn:outgoing>Kelola_flow2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Kelola_manual" name="Tambah, ubah, atau hapus barang">
      <bpmn:incoming>Kelola_flow1</bpmn:incoming>
      <bpmn:outgoing>Kelola_flow3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Kelola_upload" name="Unggah Excel jika upload diaktifkan">
      <bpmn:incoming>Kelola_flow2</bpmn:incoming>
      <bpmn:outgoing>Kelola_flow4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Kelola_validate" name="Periksa izin manajer dan validasi data">
      <bpmn:incoming>Kelola_flow3</bpmn:incoming>
      <bpmn:incoming>Kelola_flow4</bpmn:incoming>
      <bpmn:outgoing>Kelola_flow5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Kelola_valid" name="Valid?">
      <bpmn:incoming>Kelola_flow5</bpmn:incoming>
      <bpmn:outgoing>Kelola_flow6</bpmn:outgoing>
      <bpmn:outgoing>Kelola_flow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Kelola_reject" name="Tampilkan kesalahan">
      <bpmn:incoming>Kelola_flow6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Kelola_persist" name="Simpan perubahan atau sinkronkan spreadsheet berdasarkan SKU">
      <bpmn:incoming>Kelola_flow7</bpmn:incoming>
      <bpmn:outgoing>Kelola_flow8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Kelola_end" name="Data stok diperbarui">
      <bpmn:incoming>Kelola_flow8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Kelola_flow0" sourceRef="Kelola_start" targetRef="Kelola_choose" />
    <bpmn:sequenceFlow id="Kelola_flow1" sourceRef="Kelola_choose" targetRef="Kelola_manual" name="Manual" />
    <bpmn:sequenceFlow id="Kelola_flow2" sourceRef="Kelola_choose" targetRef="Kelola_upload" name="Impor Excel" />
    <bpmn:sequenceFlow id="Kelola_flow3" sourceRef="Kelola_manual" targetRef="Kelola_validate" />
    <bpmn:sequenceFlow id="Kelola_flow4" sourceRef="Kelola_upload" targetRef="Kelola_validate" />
    <bpmn:sequenceFlow id="Kelola_flow5" sourceRef="Kelola_validate" targetRef="Kelola_valid" />
    <bpmn:sequenceFlow id="Kelola_flow6" sourceRef="Kelola_valid" targetRef="Kelola_reject" name="Tidak" />
    <bpmn:sequenceFlow id="Kelola_flow7" sourceRef="Kelola_valid" targetRef="Kelola_persist" name="Ya" />
    <bpmn:sequenceFlow id="Kelola_flow8" sourceRef="Kelola_persist" targetRef="Kelola_end" />
  </bpmn:process>
