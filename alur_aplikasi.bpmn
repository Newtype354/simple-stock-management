<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Stock" targetNamespace="https://simple-stock-management.local/bpmn">
  <bpmn:process id="Transfer" name="Permintaan dan pengiriman stok" isExecutable="false">
    <bpmn:documentation>Prasyarat: pengguna sudah login dan memiliki grup yang sesuai. Diagram menjelaskan alur bisnis normal; kegagalan teknis ditampilkan sebagai error aplikasi. Notifikasi opsional ditujukan ke grup receive_mail. Stok baru berpindah ketika manajer melakukan Dispatch, bukan saat draft atau permintaan dibuat. UI toko mengunci permintaan yang sudah dikirim; backend pembatalan non-manajer memeriksa kepemilikan tetapi belum memeriksa ordered.</bpmn:documentation>
    <bpmn:laneSet id="Transfer_lanes">
      <bpmn:lane id="Transfer_lane0" name="Pengguna toko">
        <bpmn:flowNodeRef>Transfer_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_endDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_endCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Transfer_lane1" name="Manajer gudang">
        <bpmn:flowNodeRef>Transfer_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Transfer_lane2" name="Sistem aplikasi">
        <bpmn:flowNodeRef>Transfer_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_sendValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_sendReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_cancelDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_checkSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Transfer_start" name="Kebutuhan stok toko">
      <bpmn:outgoing>Transfer_flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Transfer_draft" name="Pilih barang dan jumlah transfer">
      <bpmn:incoming>Transfer_flow0</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow1</bpmn:outgoing>
      <bpmn:incoming>Transfer_flow6</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="Transfer_validate" name="Periksa hak akses, maintenance, jumlah dan stok">
      <bpmn:incoming>Transfer_flow1</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Transfer_valid" name="Permintaan valid?">
      <bpmn:incoming>Transfer_flow2</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow3</bpmn:outgoing>
      <bpmn:outgoing>Transfer_flow4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Transfer_reject" name="Permintaan ditolak">
      <bpmn:incoming>Transfer_flow3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Transfer_save" name="Simpan draft transfer; stok belum berubah">
      <bpmn:incoming>Transfer_flow4</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Transfer_choice" name="Tindakan toko?">
      <bpmn:incoming>Transfer_flow5</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow6</bpmn:outgoing>
      <bpmn:outgoing>Transfer_flow7</bpmn:outgoing>
      <bpmn:outgoing>Transfer_flow9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Transfer_cancelDraft" name="Hapus draft milik toko">
      <bpmn:incoming>Transfer_flow7</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Transfer_endDraft" name="Draft dibatalkan">
      <bpmn:incoming>Transfer_flow8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Transfer_submit" name="Kirim permintaan transfer">
      <bpmn:incoming>Transfer_flow9</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Transfer_checkSend" name="Periksa maintenance dan keberadaan draft">
      <bpmn:incoming>Transfer_flow10</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Transfer_sendValid" name="Boleh dikirim?">
      <bpmn:incoming>Transfer_flow11</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow12</bpmn:outgoing>
      <bpmn:outgoing>Transfer_flow13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Transfer_sendReject" name="Pengiriman permintaan ditolak">
      <bpmn:incoming>Transfer_flow12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Transfer_order" name="Proses notifikasi jika aktif; tandai ordered = True">
      <bpmn:incoming>Transfer_flow13</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Transfer_review" name="Manajer meninjau permintaan dan jumlah">
      <bpmn:incoming>Transfer_flow14</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow15</bpmn:outgoing>
      <bpmn:incoming>Transfer_flow20</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Transfer_decision" name="Keputusan manajer?">
      <bpmn:incoming>Transfer_flow15</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow16</bpmn:outgoing>
      <bpmn:outgoing>Transfer_flow18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Transfer_cancel" name="Hapus transfer tanpa mengubah stok">
      <bpmn:incoming>Transfer_flow16</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Transfer_endCancel" name="Transfer dibatalkan">
      <bpmn:incoming>Transfer_flow17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Transfer_dispatch" name="Validasi jumlah dan stok saat Dispatch">
      <bpmn:incoming>Transfer_flow18</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Transfer_enough" name="Stok cukup dan jumlah valid?">
      <bpmn:incoming>Transfer_flow19</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow20</bpmn:outgoing>
      <bpmn:outgoing>Transfer_flow21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Transfer_update" name="Transaksi atomik: kurangi stok gudang, tambah stok toko, hapus transfer">
      <bpmn:incoming>Transfer_flow21</bpmn:incoming>
      <bpmn:outgoing>Transfer_flow22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Transfer_end" name="Stok diterima toko dalam sistem">
      <bpmn:incoming>Transfer_flow22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Transfer_flow0" sourceRef="Transfer_start" targetRef="Transfer_draft" />
    <bpmn:sequenceFlow id="Transfer_flow1" sourceRef="Transfer_draft" targetRef="Transfer_validate" />
    <bpmn:sequenceFlow id="Transfer_flow2" sourceRef="Transfer_validate" targetRef="Transfer_valid" />
    <bpmn:sequenceFlow id="Transfer_flow3" sourceRef="Transfer_valid" targetRef="Transfer_reject" name="Tidak" />
    <bpmn:sequenceFlow id="Transfer_flow4" sourceRef="Transfer_valid" targetRef="Transfer_save" name="Ya" />
    <bpmn:sequenceFlow id="Transfer_flow5" sourceRef="Transfer_save" targetRef="Transfer_choice" />
    <bpmn:sequenceFlow id="Transfer_flow6" sourceRef="Transfer_choice" targetRef="Transfer_draft" name="Ubah" />
    <bpmn:sequenceFlow id="Transfer_flow7" sourceRef="Transfer_choice" targetRef="Transfer_cancelDraft" name="Batalkan" />
    <bpmn:sequenceFlow id="Transfer_flow8" sourceRef="Transfer_cancelDraft" targetRef="Transfer_endDraft" />
    <bpmn:sequenceFlow id="Transfer_flow9" sourceRef="Transfer_choice" targetRef="Transfer_submit" name="Kirim" />
    <bpmn:sequenceFlow id="Transfer_flow10" sourceRef="Transfer_submit" targetRef="Transfer_checkSend" />
    <bpmn:sequenceFlow id="Transfer_flow11" sourceRef="Transfer_checkSend" targetRef="Transfer_sendValid" />
    <bpmn:sequenceFlow id="Transfer_flow12" sourceRef="Transfer_sendValid" targetRef="Transfer_sendReject" name="Tidak" />
    <bpmn:sequenceFlow id="Transfer_flow13" sourceRef="Transfer_sendValid" targetRef="Transfer_order" name="Ya" />
    <bpmn:sequenceFlow id="Transfer_flow14" sourceRef="Transfer_order" targetRef="Transfer_review" />
    <bpmn:sequenceFlow id="Transfer_flow15" sourceRef="Transfer_review" targetRef="Transfer_decision" />
    <bpmn:sequenceFlow id="Transfer_flow16" sourceRef="Transfer_decision" targetRef="Transfer_cancel" name="Batalkan" />
    <bpmn:sequenceFlow id="Transfer_flow17" sourceRef="Transfer_cancel" targetRef="Transfer_endCancel" />
    <bpmn:sequenceFlow id="Transfer_flow18" sourceRef="Transfer_decision" targetRef="Transfer_dispatch" name="Dispatch" />
    <bpmn:sequenceFlow id="Transfer_flow19" sourceRef="Transfer_dispatch" targetRef="Transfer_enough" />
    <bpmn:sequenceFlow id="Transfer_flow20" sourceRef="Transfer_enough" targetRef="Transfer_review" name="Tidak; koreksi" />
    <bpmn:sequenceFlow id="Transfer_flow21" sourceRef="Transfer_enough" targetRef="Transfer_update" name="Ya" />
    <bpmn:sequenceFlow id="Transfer_flow22" sourceRef="Transfer_update" targetRef="Transfer_end" />
  </bpmn:process>
